Options -Indexes -MultiViews
DirectoryIndex index.html

<FilesMatch "^(\.|AGENTS\.md$|server\.cjs$)">
    Require all denied
</FilesMatch>

RewriteEngine On
# Normalize only the production host; local/subfolder previews remain unchanged.
RewriteCond %{HTTP_HOST} ^(?:www\.)?heungkglobal\.com$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://heungkglobal.com%{REQUEST_URI} [R=301,L]

# Serve generated language directories. Retain a fallback for unbuilt previews.
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html !-f
RewriteRule ^(ko|en|zh|ja|ru|mn|hi|ar|vi)/?$ index.html [END]
